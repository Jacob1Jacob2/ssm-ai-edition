# This repository is a public backup of SSM AI Edition. Everything listed here stays on the PC.

# ---- not worth backing up: old snapshots, scratch copies, local tools
/backups/
/host-smoke/
/tools/
/.claude/
*.log
*.pid
session.lock
level.dat_old

# ---- other people's projects, kept locally for reference only
/Github code/Ares-main/
/Github code/FeatherDisguise-master/
/Github code/Reborn-API-Clients-master/
/Github code/Reborn-Public-master/

# ---- build output (rebuilt by gradlew build)
